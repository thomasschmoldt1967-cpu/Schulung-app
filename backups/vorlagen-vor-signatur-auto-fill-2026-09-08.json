    "intervall_monate": 12,
    "abschnitte": [
      {
        "html": "<div style=\"background:#eff6ff;border-radius:8px;padding:10px 12px;border-left:4px solid #2563eb;font-size:.84rem;color:#1e3a5f;line-height:1.5;margin-bottom:12px\">Bitte vollständig ausfüllen. Diese Angaben erscheinen auf Ihrem <strong>Teilnahmenachweis</strong>.</div>",

            "pflicht": true
          },
          {
            "id": "lt_05",
            "typ": "checkbox",
            "label": "Sicherer Stand beim Arbeiten auf der Leiter gewährleistet",
            "pflicht": true
          }
        ]
      },
      {
        "html": "<div style=\"margin-bottom:12px\"><div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:10px\"><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5a.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.68rem;color:#6b7280;margin-top:3px\">Max. 150 kg</div></div><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5b.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.68rem;color:#6b7280;margin-top:3px\">Nur 1 Person</div></div><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5c.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.68rem;color:#6b7280;margin-top:3px\">Ges. Schuhwerk</div></div><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5d.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.68rem;color:#6b7280;margin-top:3px\">In Blickrichtung</div></div></div><ul style=\"font-size:.84rem;color:#374151;line-height:1.65;margin:0;padding-left:18px\"><li>Max. Belastung <strong>150 kg</strong></li><li>Nur <strong>eine Person</strong> gleichzeitig</li><li><strong>Geschlossenes Schuhwerk</strong> – kein offenes ohne Fersenriemen</li><li>Nur <strong>in Blickrichtung</strong> auf Stufen/Sprossen</li><li>Kein Aufstieg auf Hocker, Kisten, Tische, Fässer</li><li>Mitgeführtes Material: max. <strong>10 kg</strong></li></ul></div>",
        "titel": "Grundregeln der Nutzung",
        "felder": [
          {
            "id": "lt_06",
            "typ": "checkbox",
            "label": "Max. Tragfähigkeit (150 kg) bekannt und eingehalten",
            "pflicht": true
          },
          {
            "id": "lt_07",
            "typ": "checkbox",
            "label": "Nur eine Person gleichzeitig auf der Leiter",

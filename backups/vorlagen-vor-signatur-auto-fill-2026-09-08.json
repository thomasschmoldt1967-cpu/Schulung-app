            "pflicht": true
          },
          {
            "id": "lt_09",
            "typ": "checkbox",
            "label": "Nur in Blickrichtung auf Stufen/Sprossen",
            "pflicht": true
          },
          {
            "id": "lt_10",
            "typ": "checkbox",
            "label": "Keine Ersatzbehälter (Hocker, Kisten, Tische) als Aufstieg",
            "pflicht": true
          }
        ]
      },
      {
        "html": "<div style=\"margin-bottom:12px\"><div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:10px\"><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5e.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.7rem;color:#6b7280;margin-top:4px\">Nicht hinauslehnen</div></div><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5f.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.7rem;color:#6b7280;margin-top:4px\">Ebener Untergrund</div></div><div style=\"text-align:center\"><img src=\"https://www.bgbau-medien.de/handlungshilfen_gb/daten/dguv/208_016/5g.jpg\" style=\"width:100%;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.1)\"><div style=\"font-size:.7rem;color:#6b7280;margin-top:4px\">Kein verunr. Untergrund</div></div></div><div style=\"background:#fef2f2;border-radius:8px;padding:10px 12px;border-left:4px solid #dc2626;font-size:.84rem;color:#7f1d1d;line-height:1.55\">⚠️ <strong>Häufigste Unfallursache:</strong> Seitliches Hinauslehnen → Körperschwerpunkt verlässt die Holmebene → Leiter kippt. Schwerpunkt stets <strong>zwischen den Leiterholmen</strong> halten.</div></div>",

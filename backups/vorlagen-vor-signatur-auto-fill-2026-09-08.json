            "typ": "checkbox",
            "label": "Nicht zu weit seitlich hinauslehnen – Schwerpunkt zwischen den Holmen",
            "pflicht": true
          },
          {
            "id": "lt_12",
            "typ": "checkbox",
            "label": "Leiter nur auf ebenem, tragfähigem, rutschhemmendem Untergrund",
            "pflicht": true
          },
          {
            "id": "lt_13",
            "typ": "checkbox",
            "label": "Keine Nutzung bei Sturm, Eis oder Schneeglätte",
            "pflicht": true
          }
        ]
